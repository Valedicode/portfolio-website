# Optional: where the Python LangChain backend runs (see ../backend).
# /api/agent-demo is proxied here by app/api/agent-demo/route.ts; without a
# reachable backend the demo silently uses the built-in rule-based pipeline.
AGENT_BACKEND_URL=http://127.0.0.1:8000

# Shared secret sent to the backend as X-Internal-Key. Must match
# INTERNAL_API_KEY in backend/.env. Server-side only: never prefix with NEXT_PUBLIC_.
INTERNAL_API_KEY=

# Optional: Formspree (or compatible) endpoint for the contact form.
# Without it the form falls back to opening the visitor's mail client.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
