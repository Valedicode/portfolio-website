# Required: OpenRouter key that enables the LangChain agents. Use a dedicated
# key with a low credit limit (OpenRouter dashboard) as the hard spend cap.
# Without it the API returns 503 and the frontend falls back to its
# client-side rule-based pipeline.
OPENROUTER_API_KEY=

# Optional: any OpenRouter model id that supports tool calls / structured output.
# LLM_MODEL=deepseek/deepseek-chat

# Shared secret the Next.js proxy sends as X-Internal-Key. Generate a long
# random string and set the SAME value in frontend/.env.local. Unset = open
# endpoint (fine locally, refused on Vercel).
INTERNAL_API_KEY=

# Upstash Redis (REST) for rate-limit counters. Required on Vercel; locally an
# in-memory fallback is used when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional limits (defaults shown).
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_DAY=30
# GLOBAL_DAILY_CAP=300

# Optional: override where the shared knowledge base JSON lives.
# Defaults to ./data (bundled copy) if present, else ../frontend/data.
# KNOWLEDGE_DIR=
